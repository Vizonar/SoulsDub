# Vox Trupe Studios — copie para .env e preencha

# ===== Banco de dados (Neon) =====
# Dashboard do Neon > Connection Details > Connection string
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require

# ===== Discord =====
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_RECRUITMENT_CHANNEL_ID=
DISCORD_ADMIN_ROLE_IDS=

# neon = Postgres no Neon (produção). memory = só teste, sem banco.
BOT_STORAGE=neon

# ===== Regras do formulário =====
FORM_REQUIRE_AGE=false
FORM_ALLOW_UPDATES=true
FORM_UPDATE_COOLDOWN_HOURS=0

# ===== API do painel =====
# Origens do site que podem chamar a API (separadas por vírgula)
WEB_ORIGIN=https://soulsdub-jgrm-green.vercel.app,http://localhost:5173
PORT=3000
