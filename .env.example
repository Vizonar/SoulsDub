# ===== Painel web (público no navegador — NUNCA coloque segredos aqui) =====
# demo = dados fictícios em memória, sem rede. production = exige Supabase configurado.
VITE_APP_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ===== Bot (somente ambiente privado) =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_RECRUITMENT_CHANNEL_ID=

# IDs de cargos (separados por vírgula) autorizados a usar /ficha-dublador, além de quem tem permissão "Administrador".
DISCORD_ADMIN_ROLE_IDS=

# Regras de cadastro (opcionais)
FORM_REQUIRE_AGE=false
FORM_ALLOW_UPDATES=true
FORM_UPDATE_COOLDOWN_HOURS=0

# memory = guarda fichas só em memória (apenas para testar o bot sem Supabase). supabase = produção.
BOT_STORAGE=supabase
